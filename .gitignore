# OS / editor cruft
.DS_Store
Thumbs.db

# HyperFrames caches (regenerated automatically)
.thumbnails/
.transcode-cache/
.waveform-cache/

# Scratch / staging folders used during file transfers
_to_delete/
_transfer/

# Rendered output videos (large, regenerable from compositions via `npx hyperframes render`)
renders/

# Large raw source footage (kept outside git; back up separately)
chapitre1/

# All video files -- large binaries, kept out of git entirely
*.mp4
*.mov
*.webm

# Node
node_modules/

# Python bytecode cache
__pycache__/
*.pyc
